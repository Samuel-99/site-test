---
import Page from '../modeles/Page.astro';
import '../styles/pages/404.css';
import Icone from '../composants/Icone.astro';
---

<!-- PAGE : PAGE INTROUVABLE | Adresse : /404.html -->
<Page title="Page introuvable">
  <section class="container not-found">
    <p class="eyebrow">ERREUR 404</p>
    <h1>
      Un détour
      <br />
      <em>imprévu.</em>
    </h1>
    <p>
      Cette page n’existe pas ou a changé d’adresse.
      <br />
      Retrouvons le fil de la visite.
    </p>
    <a class="button button-dark" href="/">
      Revenir à l’accueil <Icone name="arrow" size={20} />
    </a>
  </section>
</Page>

---
import ImageSite from '../composants/ImageSite.astro';
import { images } from '../configuration/images';
import Page from '../modeles/Page.astro';
import '../styles/pages/parcours.css';
import IntroductionPage from '../composants/IntroductionPage.astro';
import Icone from '../composants/Icone.astro';
// REPÈRES DU PARCOURS — ajouter ou modifier une étape ici.
const timeline = [
  {
    date: '2015 — 2019',
    title: 'Un parcours bilingue',
    place: 'Gymnase de Bulle',
    text: 'Une formation en français et en allemand, après le cycle d’orientation à La Tour-de-Trême.',
  },
  {
    date: '2016',
    title: 'La musique, un engagement collectif',
    place: 'Fanfare de Vuadens',
    text: 'Un engagement au comité de la fanfare, en parallèle de la pratique du baryton.',
  },
  {
    date: '2017 — 2019',
    title: 'Le goût de transmettre',
    place: 'Cours d’appui',
    text: 'L’accompagnement d’une quinzaine d’élèves du cycle d’orientation et du gymnase.',
  },
  {
    date: '2019 — 2021',
    title: 'Explorer la technique',
    place: 'EPFL · HEIA-FR · Wago Contact SA',
    text: 'Un semestre en informatique à l’EPFL, puis une année passerelle à la HEIA-FR, avec une expérience pratique chez Wago Contact SA.',
  },
  {
    date: '2021',
    title: 'L’électronique comme fil conducteur',
    place: 'HEIA-FR',
    text: 'Le début d’un parcours de bachelor en électronique, dans une classe bilingue français–allemand.',
  },
  {
    date: '2022 — 2023',
    title: 'Une année à Munich',
    place: 'Hochschule München',
    text: 'Une année d’échange en Allemagne pendant la deuxième année de bachelor.',
  },
  {
    date: '2023',
    title: 'L’Automate solidaire',
    place: 'Vie associative',
    text: 'La cofondation de l’association, sa présidence au démarrage et une contribution au développement électronique.',
  },
];
---

<!-- PAGE : MON PARCOURS | Adresse : /parcours/ -->
<Page title="Mon parcours">
  <IntroductionPage
    number="01 /"
    label="FAIRE CONNAISSANCE"
    title="Un parcours."
    emphasis="Plusieurs horizons."
    description="L’électronique, la musique et la vie associative. Des expériences différentes, reliées par la curiosité et le goût de faire ensemble."
  />
  <!-- SECTION : Présentation et portrait -->
  <section class="container biography-split">
    <div class="bio-portrait">
      <ImageSite image={images.portrait} />
      <span>Samuel Oliveira Condesso</span>
    </div>
    <div class="biography-text">
      <p class="eyebrow">DE VUADENS À MUNICH</p>
      <h2>
        Apprendre.
        <br />
        <em>Et transmettre.</em>
      </h2>
      <p>
        Mon parcours scolaire m’a mené de Vuadens à Bulle, puis vers l’informatique et
        l’électronique. Le bilinguisme français–allemand et une année d’échange à Munich font aussi
        partie de cette histoire.
      </p>
      <p>
        J’ai donné des cours d’appui, travaillé dans l’accueil et la vente, et participé à des
        projets associatifs. Des expériences qui demandent d’écouter, de s’adapter et de travailler
        en équipe.
      </p>
      <p>
        En dehors de la technique, je pratique le baryton et la guitare. La course, le ski, le
        jardinage, l’impression 3D et la découpe laser figurent aussi parmi mes centres d’intérêt.
      </p>
    </div>
  </section>
  <!-- SECTION : Étapes du parcours -->
  <section class="container timeline-section" aria-labelledby="timeline-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">QUELQUES REPÈRES</p>
        <h2 id="timeline-title">
          Le fil du <em>parcours.</em>
        </h2>
      </div>
      <p>
        Des étapes de formation,
        <br /> de transmission et d’engagement.
      </p>
    </div>
    <ol class="timeline">
      {timeline.map((item) => (
        <li>
          <span class="timeline-date">{item.date}</span>
          <div class="timeline-content">
            <span class="eyebrow">{item.place}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="source-note">
      Repères biographiques issus du CV fourni. Les dates indiquent les étapes du parcours et ne
      présument pas des fonctions exercées aujourd’hui.
    </p>
  </section>
  <!-- SECTION : Engagements associatifs -->
  <section id="engagements" class="soft-section">
    <div class="container">
      <p class="eyebrow">LE SENS DU COLLECTIF</p>
      <h2>
        Des projets qui <em>rassemblent.</em>
      </h2>
      <div class="feature-grid">
        <article class="feature-panel">
          <span class="feature-number">01</span>
          <h3>L’Automate solidaire</h3>
          <p>
            Une association cofondée en 2023. Mon implication a porté sur sa présidence au démarrage
            et sur le développement électronique, avec des compétences en programmation, Linux et
            Raspberry Pi.
          </p>
        </article>
        <article class="feature-panel">
          <span class="feature-number">02</span>
          <h3>La Fanfare de Vuadens</h3>
          <p>
            La pratique du baryton et un engagement au comité mentionné dès 2016. Une expérience de
            la musique comme pratique collective, dans la vie locale.
          </p>
          <a class="text-link" href="/musiques/">
            Le côté musical <Icone name="external" size={18} />
          </a>
        </article>
      </div>
    </div>
  </section>
</Page>

---
import Page from '../modeles/Page.astro';
import '../styles/pages/programme.css';
import IntroductionPage from '../composants/IntroductionPage.astro';
import Icone from '../composants/Icone.astro';
// CONTENU DE CETTE PAGE — compléter la liste ci-dessous.
// Une liste vide conserve la présentation « à venir ».
type Proposal = { title: string; theme: string; summary: string; content: string };
const proposals: Proposal[] = [];
---

<!-- PAGE : PROGRAMME POLITIQUE | Adresse : /programme/ -->
<Page
  title="Programme politique"
  description="L’espace consacré aux prises de position et aux propositions politiques de Samuel Oliveira Condesso. Programme en préparation."
>
  <IntroductionPage
    number="02 /"
    label="IDÉES & ENGAGEMENT"
    title="Les idées méritent"
    emphasis="d’être développées."
    description="Un espace consacré à mes prises de position et à mes propositions. Pour donner aux idées le temps, la précision et la place qu’elles méritent."
  />
  <!-- SECTION : Propositions ou programme en préparation -->
  <section class="container programme-section">
    {proposals.length ? (
      <div class="proposal-list">
        {proposals.map((proposal) => (
          <details class="proposal">
            <summary>
              <span class="eyebrow">{proposal.theme}</span>
              <h2>{proposal.title}</h2>
              <Icone name="plus" />
            </summary>
            <p class="lead">{proposal.summary}</p>
            <p class="prose-text">{proposal.content}</p>
          </details>
        ))}
      </div>
    ) : (
      <div class="programme-state">
        <div class="programme-symbol" aria-hidden="true">
          <Icone name="compass" size={100} />
          <span>LES IDÉES PRENNENT FORME</span>
        </div>
        <div>
          <span class="status-pill">
            <span></span> Programme en préparation
          </span>
          <h2>
            Construire une pensée.
            <br />
            <em>Formuler des propositions.</em>
          </h2>
          <p>
            Le programme n’est pas encore publié. Cet espace accueillera des propositions
            détaillées, accompagnées de leurs objectifs, de leurs sources et de leurs modalités de
            mise en œuvre.
          </p>
          <a class="text-link underlined" href="/contact/">
            Une question à partager ? <Icone name="external" size={18} />
          </a>
        </div>
      </div>
    )}
  </section>
  <!-- SECTION : Pour aller plus loin -->
  <section class="soft-section">
    <div class="container">
      <p class="eyebrow">POUR ALLER PLUS LOIN</p>
      <div class="section-heading">
        <h2>
          Le parcours nourrit
          <br />
          <em>la réflexion.</em>
        </h2>
        <a class="button button-outline" href="/parcours/">
          Faire connaissance <Icone name="external" size={18} />
        </a>
      </div>
      <p class="section-summary">
        Retrouvez les expériences de formation, de vie associative et de transmission qui composent
        mon parcours.
      </p>
    </div>
  </section>
</Page>
